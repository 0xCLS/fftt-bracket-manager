/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# HTML and the compatibility stylesheet must revalidate so a changed layout
# cannot be paired indefinitely with previous CSS in a browser cache.
/
  Cache-Control: no-cache, max-age=0, must-revalidate

/index.html
  Cache-Control: no-cache, max-age=0, must-revalidate

/styles.css
  Cache-Control: no-cache, max-age=0, must-revalidate

# Versioned stylesheet: this path is tied to the exact approved CSS blob.
/styles-634f563b.css
  Cache-Control: public, max-age=31536000, immutable

/styles-489c7378.css
  Cache-Control: public, max-age=31536000, immutable

/styles-b39f1233.css
  Cache-Control: public, max-age=31536000, immutable

/styles-61fb9e56.css
  Cache-Control: public, max-age=31536000, immutable
